NODE_ENV=development

# Secret used to sign JWT access tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# MongoDB connection string (include credentials and authSource if required)
MONGODB_URI=mongodb://user:password@localhost:27017/dev-log?authSource=admin

# Redis connection used by BullMQ for background jobs (daily reports)
REDIS_HOST=localhost
REDIS_PORT=6379

# Google OAuth credentials from the Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Allowed frontend origin for CORS (comma-separated values supported in the future; single value today)
FRONTEND_URL=http://localhost:5173
